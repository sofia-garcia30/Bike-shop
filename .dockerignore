# Archivos compilados y dependencias
target/
*.jar
*.war
*.ear
!target/*.jar  # Excepción: si necesitas el JAR final, pero mejor no incluir la carpeta completa

# Logs
*.log

# Archivos de configuración sensibles (los que contengan credenciales)
application.properties
application-*.properties
!application.properties.example  # Si tienes un archivo de ejemplo, puedes excluirlo

# Entornos virtuales/IDE
.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# Control de versiones
.git/
.gitignore
.dockerignore  # El propio .dockerignore no suele ser necesario, pero se puede incluir

# Docker compose (no necesario para la imagen)
docker-compose.yml
docker-compose*.yml

# Archivos temporales
*.swp
*.swo
*~
.DS_Store